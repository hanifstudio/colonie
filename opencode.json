{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "~/.colonie", "effect": "deny" },
    { "action": "read", "resource": "~/.colonie/*", "effect": "deny" },
    { "action": "read", "resource": "~/.colonie-workspaces", "effect": "deny" },
    { "action": "read", "resource": "~/.colonie-workspaces/*", "effect": "deny" },
    { "action": "read", "resource": "~/.codex/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.colonie/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.colonie-workspaces/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.colonie/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.colonie-workspaces/*", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "ask" },
    { "action": "edit", "resource": ".codex/*", "effect": "ask" },
    { "action": "edit", "resource": ".claude/settings.json", "effect": "ask" },
    { "action": "edit", "resource": "scripts/agent-guard.mjs", "effect": "ask" },
    { "action": "edit", "resource": "scripts/commit-guard.mjs", "effect": "ask" },
    { "action": "edit", "resource": "scripts/git-hooks/*", "effect": "ask" },

    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "*--no-verify*", "effect": "deny" },
    { "action": "shell", "resource": "git commit -n*", "effect": "deny" },
    { "action": "shell", "resource": "git commit * -n*", "effect": "deny" },
    { "action": "shell", "resource": "*core.hooksPath *", "effect": "deny" },
    { "action": "shell", "resource": "*core.hooksPath=*", "effect": "deny" },
    { "action": "shell", "resource": "*--unset*core.hooksPath*", "effect": "deny" },
    { "action": "shell", "resource": "git config core.hooksPath scripts/git-hooks", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh release create*", "effect": "deny" },

    { "action": "shell", "resource": "*~/.colonie", "effect": "deny" },
    { "action": "shell", "resource": "*~/.colonie *", "effect": "deny" },
    { "action": "shell", "resource": "*~/.colonie/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.colonie-workspaces*", "effect": "deny" },
    { "action": "shell", "resource": "*$HOME/.colonie", "effect": "deny" },
    { "action": "shell", "resource": "*$HOME/.colonie *", "effect": "deny" },
    { "action": "shell", "resource": "*$HOME/.colonie/*", "effect": "deny" },
    { "action": "shell", "resource": "*$HOME/.colonie-workspaces*", "effect": "deny" },
    { "action": "shell", "resource": "*.codex/auth.json*", "effect": "deny" },
    { "action": "shell", "resource": "*.claude/.credentials*", "effect": "deny" },
    { "action": "shell", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.ssh*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*security find-generic-password*", "effect": "deny" },
    { "action": "shell", "resource": "*security find-internet-password*", "effect": "deny" },

    { "action": "shell", "resource": "rm -*r* /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*R* /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*r* ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*r* $HOME*", "effect": "deny" },
    { "action": "shell", "resource": "rm --recursive *", "effect": "deny" },
    { "action": "shell", "resource": "rm -*r* /tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -*r* /private/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -*r* /var/folders/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -*r* /private/var/folders/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -*r* $TMPDIR*", "effect": "allow" },
    { "action": "shell", "resource": "rm -*r* *..*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*R* *..*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*r* * /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*R* * /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*r* * ~*", "effect": "deny" }
  ]
}
