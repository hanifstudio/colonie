[Unit]
Description=Colonie accounts and Cloud workspaces
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=colonie
Group=colonie
WorkingDirectory=/opt/colonie/platform-app
Environment=NODE_ENV=production
Environment=COLONIE_PLATFORM_CONFIG=/opt/colonie/platform-data/platform.json
ExecStart=/usr/bin/node /opt/colonie/platform-app/dist-platform/host.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/colonie/platform-data
ReadOnlyPaths=/opt/colonie/data /opt/colonie/app
UMask=0077

[Install]
WantedBy=multi-user.target
