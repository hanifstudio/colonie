[Unit]
Description=Colonie HTTPS gateway
After=network-online.target colonie-platform.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=colonie-https
Group=colonie-https
EnvironmentFile=/etc/colonie/https.env
Environment=XDG_DATA_HOME=/var/lib/colonie-https/data
Environment=XDG_CONFIG_HOME=/var/lib/colonie-https/config
ExecStart=/usr/local/bin/colonie-caddy run --config /etc/colonie/Caddyfile --adapter caddyfile
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/colonie-https/data /var/lib/colonie-https/config

[Install]
WantedBy=multi-user.target
