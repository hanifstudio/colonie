# Colonie as a shared always-on workspace. See docs/deploy-colonie-vps.md.
# Install to /etc/systemd/system/colonie.service.
[Unit]
Description=Colonie server
Documentation=file:///opt/colonie/app/docs/deploy-colonie-vps.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=colonie
Group=colonie
WorkingDirectory=/opt/colonie/app

# Colonie's own profile: two ACP engines, isolated engine config dirs, app data
# under OMB_DATA_DIR rather than the invoking user's home.
Environment=COLONIE_PROFILE=1
Environment=NODE_ENV=production
Environment=HOME=/opt/colonie
Environment=OMB_DATA_DIR=/opt/colonie/data
Environment=OMB_PORT=18891
Environment=OMB_WEBHOOK_PORT=18892
Environment=OMB_STATIC_DIR=/opt/colonie/app/dist

# REQUIRED on any server more than one person reaches, and the reason is not
# obvious: a session-less loopback request is otherwise trusted as the owner,
# and every bot's shell is a loopback caller. Without this, a workspace member
# can ask a bot to curl the local API and change settings, API keys, MCP
# servers or webhooks as you. Do not remove it to debug something.
Environment=OMB_LOOPBACK_TRUST=service

ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
Restart=on-failure
RestartSec=5
# A build or a bad config should not spin forever; after this many failures in
# the interval systemd gives up and `systemctl status` says why.
StartLimitBurst=5
StartLimitIntervalSec=120

# The service needs its own data dir and the app tree, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/colonie/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=colonie

[Install]
WantedBy=multi-user.target
