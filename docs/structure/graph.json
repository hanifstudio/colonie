  "ruleSource": "scripts/structure/import-boundaries.json",
  "rules": [
    {
      "id": "no-imports-of-index",
      "why": "index.ts is the composition root and the process entry point; anything importing it would make the boot order load-bearing again, which is what the restructure removed.",
      "violations": 0,
      "grandfathered": 0
    },
    {
      "id": "shared-is-portable",
      "why": "shared/ is compiled into both the server and the renderer; reaching into either side makes it a two-sided module with a build dependency nobody declared.",
      "violations": 0,
      "grandfathered": 0
    },
    {
      "id": "no-server-to-ui",
      "why": "the server does not run in the renderer; an import here would only ever work in the dev build where both trees exist on disk.",
      "violations": 0,
      "grandfathered": 0
    },
    {
      "id": "no-ui-to-server",
      "why": "the renderer talks to the server over HTTP/SSE. Importing server internals would pull SQL, credentials and provider code into the browser bundle.",
      "violations": 0,
      "grandfathered": 0
    },
    {
      "id": "feature-not-to-composition",
      "why": "harness/ is the composition and startup layer: a feature that imports it cannot be tested or read without booting the server. routes/ is the adapter layer that depends on features, never the reverse. Two modules are the sanctioned exception: routes/table.ts is the shared route contract the blueprint tells feature-owned adapters to reuse, and harness/http.ts is a shared request/response helper that carries no boot order.",
      "violations": 0,
      "grandfathered": 0
    }
  ],
