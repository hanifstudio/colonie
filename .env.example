# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=colonie
COLONIE_BIND_ADDRESS=127.0.0.1
COLONIE_HTTP_PORT=8080
# Leave empty to use http://localhost:${COLONIE_HTTP_PORT:-8080}.
COLONIE_PUBLIC_URL=
# Leave empty to inherit COLONIE_PUBLIC_URL.
COLONIE_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set COLONIE_PUBLIC_URL to https:// followed by the same hostname.
# Requires COLONIE_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
COLONIE_HTTPS_HOST=
COLONIE_BASE_IMAGE=ghcr.io/hanifstudio/colonie:latest
COLONIE_LOCAL_IMAGE=colonie-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
COLONIE_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
COLONIE_DATA_EXTERNAL=false
