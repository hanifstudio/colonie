// Colonie Cloud on Cloudflare Workers. Secrets are not here: the owner sets
// SIGNING_JWK and RESEND_API_KEY with `wrangler secret put`. Local
// development reads DATABASE_URL, ISSUER and SIGNING_JWK from .dev.vars
// (never committed).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colonie-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto scrypt, randomBytes and createHash
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // The public address; changes to the bought domain before release.
    "ISSUER": "https://colonie-cloud.hanifyaskur.workers.dev"
  },
  // Neon (Singapore) through Hyperdrive. `wrangler dev` uses DATABASE_URL
  // from .dev.vars instead.
  // Disconnected on October 21: that Neon database belongs to another app.
  // Point a new Hyperdrive config at Colonie Cloud's own database.
  "hyperdrive": []
}
