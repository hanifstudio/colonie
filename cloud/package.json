  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^26.2.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "4.148.0",
    "@cloudflare/workers-types": "5.20261006.1"
  }
}
