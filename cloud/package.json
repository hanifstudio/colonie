{
  "name": "colonie-cloud",
  "private": true,
  "type": "module",
  "description": "Colonie Cloud: the one Colonie-run backend (accounts first). Cloudflare Workers + Neon Postgres.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
