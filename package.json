{
  "name": "colonie",
  "private": true,
  "version": "0.2.0",
  "description": "Colonie — a local desktop workspace for people and their AI bots.",
  "homepage": "https://github.com/hanifstudio/colonie",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanifstudio/colonie.git"
  },
  "author": "Colonie contributors",
  "license": "Apache-2.0",
  "desktopName": "com.colonie.app.desktop",
  "type": "module",
  "main": "electron/colonie.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "colonie": "node scripts/colonie/start.ts",
    "colonie:web": "node scripts/colonie/start.ts --web",
    "colonie:test": "vitest run server/acp/ server/colonie/ src/components/BloubAvatar.test.ts",
    "colonie:build": "node scripts/colonie/icons.ts && pnpm build && pnpm build:server && node scripts/colonie/stage-runtime.mjs",
    "colonie:build:server": "pnpm build && pnpm build:server && node scripts/colonie/stage-runtime.mjs",
    "colonie:package": "pnpm colonie:build && electron-builder --config electron-builder.colonie.yml --mac --dir --publish never",
    "colonie:dist": "pnpm colonie:build && electron-builder --config electron-builder.colonie.yml --mac --arm64 --publish never",
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:colonie": "node --experimental-strip-types scripts/control-colonie.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm structure:check && pnpm test",
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "structure:check": "node scripts/structure/check-structure.mjs",
    "structure:measure": "node scripts/structure/measure-history.mjs && node scripts/structure/measure-graph.mjs",
    "test": "vitest run",
    "test:electron": "node --test \"electron/*.node-test.mjs\"",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "gen:bodies": "node --experimental-strip-types scripts/gen-mascot-bodies.ts",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:cua:win": "node scripts/prepare-cua-win.mjs",
    "smoke:cua-win": "node scripts/smoke-cua-win-embedded.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "smoke:browser": "node scripts/smoke-browser-bundle.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:updater && pnpm build:android-tools && pnpm build:browser",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && pnpm build:cua:win && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux --x64 --publish never",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --linux --x64 --publish never",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-update": "xvfb-run -a electron --no-sandbox scripts/smoke-linux-update.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.88.0",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "1.7.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@novnc/novnc": "1.7.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@trycua/cua-driver": "0.28.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.1",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "lucide-react": "^0.539.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "posthog-js": "^1.415.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxlint": "1.80.0",
    "playwright": "1.64.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "4.123.0",
    "ws": "8.22.0"
  }
}
